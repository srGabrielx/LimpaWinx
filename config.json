{
  "version": "1.0.0",
  "app_name": "Smart PC Cleaner",
  "realtime_watchdog": {
    "enabled": true,
    "check_interval_seconds": 15,
    "ram_threshold_percent": 80,
    "ram_cooldown_seconds": 120,
    "auto_flush_dns": true,
    "min_disk_free_gb": 5.0,
    "enable_toast_notifications": true
  },
  "safety": {
    "ask_confirmation_for_level_3": true,
    "ignore_extensions": [
      ".lock",
      ".pid",
      ".sock",
      ".db-wal",
      ".git"
    ],
    "ignore_folders": [
      "System Volume Information",
      "$Recycle.Bin",
      "Recovery"
    ]
  },
  "levels": {
    "1": {
      "name": "Nível 1 — Básico / Seguro (1/3)",
      "description": "Limpeza rápida de temporários de usuário, lixeira, cache DNS e otimização leve de RAM.",
      "requires_admin": false,
      "actions": [
        "recycle_bin",
        "user_temp",
        "flush_dns",
        "optimize_ram_user"
      ]
    },
    "2": {
      "name": "Nível 2 — Performance Avançada (2/3)",
      "description": "Inclui Nível 1 + Temp do sistema, Prefetch, limpeza profunda de RAM via API, Crash Dumps e Privacidade (Navegadores).",
      "requires_admin": true,
      "actions": [
        "recycle_bin",
        "user_temp",
        "system_temp",
        "crash_dumps",
        "thumbnail_cache",
        "prefetch",
        "clean_browsers",
        "flush_dns",
        "optimize_ram_all"
      ]
    },
    "3": {
      "name": "Nível 3 — Limpeza Profunda & Manutenção (3/3) ULTIMATE",
      "description": "Inclui Nível 2 + logs, Windows Update, DISM WinSxS e Ponto de Restauração.",
      "requires_admin": true,
      "actions": [
        "restore_point",
        "recycle_bin",
        "user_temp",
        "system_temp",
        "crash_dumps",
        "thumbnail_cache",
        "prefetch",
        "clean_browsers",
        "windows_event_logs",
        "windows_update_cache",
        "dism_cleanup",
        "dev_caches",
        "flush_dns",
        "optimize_ram_all"
      ]
    }
  },
  "custom_rules": [
    {
      "id": "dev_npm_pip",
      "name": "Limpar caches de desenvolvimento (npm, pip)",
      "keywords": ["npm", "pip", "node_modules", "devcache", "pacotes"],
      "action_type": "shell_cmd",
      "command": "npm cache clean --force 2>nul & pip cache purge 2>nul",
      "requires_admin": false,
      "enabled": true
    },
    {
      "id": "discord_cache",
      "name": "Cache do Discord",
      "keywords": ["discord", "chat cache"],
      "action_type": "delete_dir_content",
      "path": "%APPDATA%\\discord\\Cache",
      "requires_admin": false,
      "enabled": true
    },
    {
      "id": "chrome_cache",
      "name": "Cache do Google Chrome",
      "keywords": ["chrome", "navegador", "browser"],
      "action_type": "delete_dir_content",
      "path": "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\Default\\Cache",
      "requires_admin": false,
      "enabled": true
    },
    {
      "id": "edge_cache",
      "name": "Cache do Microsoft Edge",
      "keywords": ["edge", "msedge"],
      "action_type": "delete_dir_content",
      "path": "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\Default\\Cache",
      "requires_admin": false,
      "enabled": true
    }
  ]
}
